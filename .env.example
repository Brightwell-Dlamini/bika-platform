# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never expose as NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Cron (SLA monitor) — required for scheduled /api/cron/sla-check
# Generate: openssl rand -hex 32
CRON_SECRET=

# USSD gateway (deferred product; still guards /api/ussd if used)
USSD_WEBHOOK_SECRET=

# Optional — shared rate limits (multi-instance / serverless)
# Free tier: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — notifications
NOTIFY_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=BIKA <alerts@your-domain.gov.sz>
NOTIFY_TO_EMAIL=command@bika.gov.sz
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=+2687...
